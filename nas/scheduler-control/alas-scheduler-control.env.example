# Install as /etc/default/alas-scheduler-control and keep mode 600.

ALAS_ROOT=/path/to/AzurLaneAutoScript
ALAS_CONTAINER=alas
ALAS_SCHEDULER_PAYLOAD=/opt/lib/alas-scheduler-control/local_scheduler_control.py
ALAS_SCHEDULER_STATE_DIR=/var/lib/alas-scheduler-repair
ALAS_SCHEDULER_BACKUP_DIR=/var/backups/alas-scheduler-control
ALAS_SCHEDULER_STABLE_SECONDS=90
