# Install as /etc/default/alas-supervisor, keep mode 600 and edit locally.

ALAS_CONTAINER=alas
ALAS_ROOT=/path/to/AzurLaneAutoScript

# ALAS always connects to this stable local HAProxy endpoint.
ALAS_ADB_SERVER_HOST=127.0.0.1
ALAS_ADB_SERVER_PORT=5037
ALAS_ADB_SERIAL=127.0.0.1:16555

# Leave empty if config/alas.json contains a usable CN ServerName. Otherwise,
# set a valid CN server display name locally; never commit the selected name.
ALAS_SERVER_NAME=

# Shared root-only MQTT configuration used by error-notify.
ALAS_MQTT_CONFIG=/etc/alas-monitor.conf
ALAS_MQTT_RECOVERY_TOPIC=nas/alas/recovery
